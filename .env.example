# Copy to .env.scripts, here or at the app repo root. Both are checked, the app
# root first, so a submodule checkout shares the app's file and a bare clone can
# have its own.
#
# There is deliberately NO FALLBACK to the app project's credentials: the
# fallback used to make the production household database the default target of
# every load, with nothing between it and a service-role write but a printed
# hostname.
CATALOG_SUPABASE_URL=
CATALOG_SUPABASE_SERVICE_ROLE_KEY=
